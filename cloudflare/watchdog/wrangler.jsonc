{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "courtwatch-watchdog",
  "main": "src/index.js",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": [
      "0,15,30,45 * * * *",
      "5,20,35,50 * * * *",
      "10,25,40,55 * * * *",
      "3,13,23,33,43,53 * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
