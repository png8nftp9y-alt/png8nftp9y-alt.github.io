    "text": "<!DOCTYPE html>\r\n<html lang=\"it\">\r\n  <head>\r\n    <meta charset=\"UTF-8\" />\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\r\n    <title>Tabellone FITP - sola visualizzazione</title>\r\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\r\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\r\n    <link\r\n      href=\"https://fonts.googleapis.com/css2?family=Roboto+Condensed:wght@400;600;700&display=swap\"\r\n      rel=\"stylesheet\"\r\n    />\r\n    <style>\r\n      /* ----------------------------------------------------------------\r\n       Stili presi (e \"appiattiti\" da SCSS a CSS puro) dal componente\r\n       Bracket.vue del progetto sgat-back-office.\r\n       Sono gli unici stili usati dall'HTML generato dal motore legacy.\r\n    ---------------------------------------------------------------- */\r\n      :root {\r\n        --bs-link-color: #0d6efd;\r\n      }\r\n\r\n      body {\r\n        margin: 0;\r\n        padding: 24px;\r\n        background: #fff;\r\n        font-family: \"Roboto Condensed\", \"Helvetica Neue\", Arial, sans-serif;\r\n      }\r\n\r\n      /* Wrapper scrollabile orizzontalmente (come .Bracket__wrapper) */\r\n      .Bracket__wrapper {\r\n        width: 100%;\r\n        overflow-x: auto;\r\n      }\r\n\r\n      .tabellone {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        font-size: 12px;\r\n        font-family: \"Roboto Condensed\", \"Helvetica Neue\", Arial, sans-serif;\r\n        color: #111;\r\n        transform-origin: 0 0;\r\n      }\r\n\r\n      .tabellone td {\r\n        padding: 0;\r\n        white-space: nowrap;\r\n        vertical-align: middle;\r\n      }\r\n\r\n      .tabellone .zoom {\r\n        min-width: 180px;\r\n        padding: 2px 6px;\r\n        display: block;\r\n      }\r\n\r\n      .tabellone .risultato {\r\n        font-size: 12px;\r\n        font-weight: 600;\r\n        letter-spacing: 0.05em;\r\n      }\r\n\r\n      /* Le 4 classi che disegnano le \"linee\" del tabellone */\r\n      .tabellone .bianca {\r\n        border: none;\r\n      }\r\n\r\n      .tabellone .bassa {\r\n        border-bottom: 1px solid #000;\r\n      }\r\n\r\n      .tabellone .destra {\r\n        border-right: 1px solid #000;\r\n      }\r\n\r\n      .tabellone .bassadestra {\r\n        border-right: 1px solid #000;\r\n        border-bottom: 1px solid #000;\r\n      }\r\n\r\n      .tabellone center {\r\n        display: block;\r\n        text-align: center;\r\n      }\r\n\r\n      /* Trucco per evitare che il grassetto (hover) faccia \"saltare\" la larghezza */\r\n      .tabellone .bold-no-expand {\r\n        display: inline-block;\r\n        position: relative;\r\n      }\r\n      .tabellone .bold-no-expand__spacer {\r\n        font-weight: bold;\r\n        visibility: hidden;\r\n        white-space: nowrap;\r\n      }\r\n      .tabellone .bold-no-expand__visible {\r\n        position: absolute;\r\n        left: 0;\r\n        top: 0;\r\n        white-space: nowrap;\r\n      }\r\n\r\n      @media (max-width: 768px) {\r\n        .tabellone .zoom {\r\n          min-width: 140px;\r\n        }\r\n      }\r\n\r\n      /* INTESTAZIONE */\r\n      .tournamentName,\r\n      .competitionName,\r\n      .phaseName {\r\n        color: #003671;\r\n        font-weight: 700;\r\n        line-height: 23px;\r\n        text-transform: uppercase;\r\n      }\r\n\r\n      .competitionName {\r\n        font-size: 24px;\r\n      }\r\n\r\n      .tournamentName {\r\n        font-size: 20px;\r\n      }\r\n\r\n      .phaseName {\r\n        font-size: 15px;\r\n        padding-bottom: 30px;\r\n        color: #47d7f1;\r\n      }\r\n\r\n      /* Sezioni multiple e messaggi di stato */\r\n      .tabellone-sezione + .tabellone-sezione {\r\n        margin-top: 48px;\r\n        padding-top: 32px;\r\n        border-top: 1px solid #ddd;\r\n      }\r\n\r\n      .messaggio {\r\n        color: #003671;\r\n        font-size: 16px;\r\n        font-weight: 600;\r\n      }\r\n\r\n      .messaggio--errore {\r\n        color: #b00020;\r\n      }\r\n    </style>\r\n  </head>\r\n  <body>\r\n    <div id=\"tabellone-root\"></div>\r\n\r\n    <script>\r\n      // =================================================================\r\n      //  API: il tabellone viene caricato dalla function Azure.\r\n      //  GET .../api/v2/puc/competizione/tabellone?tournamentId=..&phaseId=..\r\n      //  Risposta attesa:\r\n      //   { results: [ { torneo, gara, sezione, partite: [ ...match ] } ] }\r\n      //  Vedi loadTabellone() in fondo allo script.\r\n      // =================================================================\r\n\r\n      // =================================================================\r\n      //  CAST: arricchisce il flusso con i campi di \"collegamento\"\r\n      //  che l'algoritmo legacy si aspetta ma che il JSON non ha:\r\n      //   - IDIscritto1/2        -> identita giocatore (uso il numero tessera)\r\n      //   - IDVincitore          -> tessera del vincitore della partita\r\n      //   - IDPartitaFrom_Iscritto1/2 -> IdPartita da cui arriva il giocatore\r\n      //\r\n      //  La regola per il collegamento e' STRUTTURALE (non basata sui\r\n      //  vincitori): in un tabellone a eliminazione la partita al turno T\r\n      //  in posizione P e' alimentata dalle due partite ",
    "scriptUrls": [],
    "scripts": []
  }
}
