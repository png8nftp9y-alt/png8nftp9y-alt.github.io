    "inlineSnippet": "\n\n\n\n\n\n\n\n\n\n\nmoment.locale('it');\nwindow.suppressAjaxError = true;\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\r\n\t\t\tjQueryV2(\"#top-header\").load(\"/common/top-header.html\");\r\n\t\t\n\r\n\t\tjQueryV2(\"#dynamic-top-menu\").load(\"/common/top-menu.html\");\r\n\t\n\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tvar progressValue = document.querySelector('.cc-circle-graph-1 .cc-progress-value');\r\n\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tvar RADIUS = 54;\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tvar CIRCUMFERENCE = 2 * Math.PI * RADIUS;\r\n\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tfunction progress(value) {\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tvar progress = value / 100;\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tvar dashoffset = CIRCUMFERENCE * (1 - progress);\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tprogressValue.style.strokeDashoffset = dashoffset;\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\r\n\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tprogressValue.style.strokeDasharray = CIRCUMFERENCE;\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t//progress(50); // Questa è la percentuale da toccare!! Il valore è la percentuale di sconfitte!\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tvar progressValue2 = document.querySelector('.cc-circle-graph-2 .cc-progress-value');\r\n\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tvar RADIUS = 54;\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tvar CIRCUMFERENCE = 2 * Math.PI * RADIUS;\r\n\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tfunction progress2(value) {\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tvar progress = value / 100;\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tvar dashoffset = CIRCUMFERENCE * (1 - progress);\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tprogressValue2.style.strokeDashoffset = dashoffset;\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\r\n\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tprogressValue2.style.strokeDasharray = CIRCUMFERENCE;\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t//progress(50); // Questa è la percentuale da toccare!! Il valore è la percentuale di sconfitte!\r