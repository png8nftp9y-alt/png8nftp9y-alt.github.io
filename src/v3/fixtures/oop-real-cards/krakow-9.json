\n              var locationElement = $('.js-location-selection-select');\r\n              var location = '';\r\n              if (locationElement.length > 0) {\r\n                location = locationElement.find(':selected').val();\r\n              }\r\n\r\n              autoSuggestOptions.postParamObject['date'] = date;\r\n              autoSuggestOptions.postParamObject['location'] = location;\r\n            }\r\n\r\n            $('.js-autosuggest').VisualAutoSuggest(autoSuggestOptions);\r\n          };\r\n\r\n          matches.init = function(options) {\r\n            autoSuggestOptions = options;\r\n            matches.bindAutoSuggest(false);\r\n\r\n            $('.js-date-selection-select')\r\n              .on('change',\r\n                function() {\r\n                  var url = '/tournament/5968E358-FA12-4802-A23A-8861154B3A6D/Matches?date=20260826';\r\n                  url = url.split('?date')[0];\r\n                  url = url + '/' + $(this).find(':selected').val();\r\n\r\n                  history.replaceState('', document.title, url);\r\n                }\r\n              );\r\n          };\r\n\r\n          matches.onBegin = function() {\r\n            $('#js-is-loading').addClass('is-loading');\r\n          };\r\n\r\n          matches.onComplete = function() {\r\n            $('#js-is-loading').removeClass('is-loading');\r\n            matches.bindAutoSuggest(true);\r\n          };\r\n        }(tournament.matches = tournament.matches || {}, $));\r\n\r\n        // Players\r\n        (function(players, $, undefined) {\r\n          var onContentScroll = function() {\r\n            var $list = $('.js-alphabet-list');\r\n            var $nav = $('.js-alphabet-list-navigation');\r\n\r\n              if ($list.length > 0 && $list.offset().top + $list.height() >= $(window).scrollTop() + $(window).height()) {\r\n              $nav.addClass('is-visible');\r\n\r\n              $nav.find('.is-active').removeClass('is-active');\r\n            } else {\r\n              $nav.removeClass('is-visible');\r\n            }\r\n            };\r\n\r\n          var onFilterQueryInput = function() {\r\n              if ($('#Filter_Query').val()) {\r\n                          $('.icon-x__trigger').removeClass('is-hidden');\r\n                      } else {\r\n                          $('.icon-x__trigger').addClass('is-hidden');\r\n                      };\r\n          };\r\n\r\n          var onClearFilter = function() {\r\n              $('#Filter_Query').val(\"\");\r\n                      $.ajax({\r\n                          url: 'Players/GetPlayersContent',\r\n                          success: function(data) {\r\n                              $(\"#PlayersView\").html(data);\r\n                          }\r\n                      });\r\n                      $('#Filter_Query').trigger(\"change\");\r\n                      $('.icon-x__trigger').addClass('is-hidden');\r\n                  };\r\n\r\n          var onFilter = function() {\r\n            var $list = $('.js-alphabet-list');\r\n            if ($list) {\r\n              var $nav = $('.js-alphabet-list-navigation');\r\n              var $noResults = $('.js-alphabet-list-no-results');\r\n              var $items = $list.find('.js-alphabet-list-item');\r\n              var itemFunction = function() {\r\n                return $(this).children().text().toUpperCase().indexOf($('.js-tournament-players-filter-query').val().toUpperCase()) >= 0;\r\n              };\r\n              var $visibleItems = $items.filter(itemFunction).show();\r\n              $items.not($visibleItems).hide().parent().closest('li').hide();\r\n              $visibleItems.parent().closest('li').show();\r\n              if ($visibleItems.length > 0) {\r\n                  $noResults.addClass('is-hidden');\r\n              } else {\r\n                  $noResults.removeClass('is-hidden');\r\n              }\r\n              $nav.find('.js-alphabet-list-navigation-link')\r\n                .each(function() {\